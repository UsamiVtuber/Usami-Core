# Dependências e build
node_modules/
dist/

# Backup local
_backup/

# Modelos e runtime de terceiros (licenças não verificadas; mantidos apenas localmente)
public/models/
public/live2d/

# Cache de áudio TTS gerado em runtime
data/

# Descartável: logs de servidor, mídia de demonstração e saídas de verificação
/tmp/

# O dev server às vezes é lançado com saída redirecionada na raiz; não é conteúdo do repo
/vite.log
/vite.err.log

# Bytecode Python (tools/ingest)
__pycache__/
*.pyc

# Arquivos de ambiente (chaves nunca entram no repositório)
.env
