{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "checkJs": false,
    "maxNodeModuleJsDepth": 1
  },
  "include": [
    "src/**/*",
    "server.mjs",
    "scripts/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "data"
  ]
}
